# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== MongoDB =====
MONGODB_URI=mongodb://localhost:27017/railresolve

# ===== JWT =====
# Shared dev-only secret — fine for local team use in this private repo.
# Generate a real random one before any real deployment.
JWT_SECRET=railresolve_dev_jwt_secret_2026_do_not_use_in_prod
JWT_EXPIRES_IN=24h

# ===== Password Hashing =====
BCRYPT_SALT_ROUNDS=10

# ===== FastAPI Processing Service =====
FASTAPI_URL=http://localhost:8000
# MUST exactly match INTERNAL_SERVICE_TOKEN in railresolve-fastapi-backend/.env
INTERNAL_SERVICE_TOKEN=railresolve_dev_internal_token_2026
FASTAPI_REQUEST_TIMEOUT_MS=8000

# ===== CORS =====
CLIENT_ORIGIN=http://localhost:5173

# ===== File Upload Limits (bytes) =====
MAX_IMAGE_SIZE_BYTES=5242880
MAX_DOCUMENT_SIZE_BYTES=10485760

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
COMPLAINT_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=20

# ===== Logging =====
LOG_LEVEL=info
