# ============================================================
# RailResolve — Frontend (React + Vite) environment
# ============================================================
# Copy to `.env` before running `npm run dev`.
#
# Anything prefixed with VITE_ is inlined into the JavaScript bundle and is
# therefore PUBLIC. Never put a secret here.
#
# Do NOT add to this file:
#   - LLM / OpenAI / Anthropic API keys
#   - INTERNAL_SERVICE_TOKEN (Express <-> FastAPI)
#   - JWT_SECRET
#   - MongoDB credentials
# Those belong only in the backend .env files.

# Base URL of the Express core backend. The browser talks to Express and
# nothing else — FastAPI (:8000) is reached internally by Express, never
# directly from React.
VITE_API_BASE_URL=http://localhost:5000/api
