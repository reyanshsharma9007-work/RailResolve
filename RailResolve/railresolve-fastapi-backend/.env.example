# ===== Server =====
PORT=8000
ENVIRONMENT=development

# ===== Internal Service Auth =====
# MUST exactly match INTERNAL_SERVICE_TOKEN in railresolve-express-backend/.env
INTERNAL_SERVICE_TOKEN=_iOE95c15gTO3ypAUfgwMNw0MvbRjkSVo__Gcr7daBk

# ===== LLM Provider =====
# Leave LLM_API_KEY blank to test the fail-safe path (AI analysis will
# gracefully report "unavailable" — the complaint workflow still works).
# Fill in a real key once your team has one; no code changes needed.
LLM_BASE_URL=https://api.llm-provider.com/v1
LLM_API_KEY=<optional-not-required-for-rule-based-ai>
LLM_PRIMARY_MODEL=qwen3-32b
LLM_FALLBACK_MODEL=mistral-small-24b
LLM_TIMEOUT=30

# ===== CORS (only Express should ever call this service) =====
ALLOWED_ORIGIN=http://localhost:5000

DUPLICATE_THRESHOLD=0.72

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Complaint category ML model (TF-IDF + LinearSVC) =====
# Artifacts are produced by `python -m training.train_category_model` into models/category/.
# If the folder is missing or fails its SHA-256 check, the service falls back to the rule-based classifier.
CATEGORY_MODEL_ENABLED=true
CATEGORY_MODEL_DIR=models/category
# Leave unset to use the threshold stored with the model (0.5). Lower = more auto-classified, less accurate.
# CATEGORY_MIN_CONFIDENCE=0.5

# ===== Priority/urgency ML model (Model 2: TF-IDF + calibrated logistic regression) =====
# Artifact is produced by `python -m training.train_priority_model` into artifacts/priority/ and is
# bundled into the image. If missing/corrupt, /internal/ai/predict-priority returns 503 and /analyze
# simply omits `mlPriority`; Model 1 and the rule-based priority are unaffected.
PRIORITY_MODEL_ENABLED=true
PRIORITY_MODEL_DIR=artifacts/priority
